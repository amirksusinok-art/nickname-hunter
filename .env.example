# Server Port and Host
PORT=3000
HOST=0.0.0.0

# Database URL (Leave empty to use built-in PGlite engine for local development)
# DATABASE_URL=postgres://nickhunter:nickhunter_pass@localhost:5432/nickdrop

# Telegram Bot Token from @BotFather for HMAC-SHA256 initData validation
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Enable browser mock user when running locally outside Telegram (true/false)
DEV_MOCK=true
